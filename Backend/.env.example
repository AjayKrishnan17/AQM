PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/aqi_dashboard

# simulated (default) or live_api
DATA_MODE=live_api

# Tiruchirappalli, Tamil Nadu. Open-Meteo requires no API key.
OPEN_METEO_LATITUDE=10.7905
OPEN_METEO_LONGITUDE=78.7047

# Auto-update interval in milliseconds (default: 3600000 = 1 hour)
# Examples: 300000 = 5 min, 600000 = 10 min, 1800000 = 30 min, 3600000 = 1 hour
AUTO_UPDATE_INTERVAL=3600000
